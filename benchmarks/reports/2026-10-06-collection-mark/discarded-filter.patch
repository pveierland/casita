+/// tolerant pin traversal must not mark an input whose record is still absent.
+async fn unmarked_frontier(
+    marked: &SpillSet<ObjectKey>,
+    frontier: Vec<(Option<ObjectKey>, ObjectKey)>,
+) -> Result<Vec<(Option<ObjectKey>, ObjectKey)>, RepositoryError> {
+    let keys: Vec<_> = frontier.iter().map(|(_, key)| key).collect();
+    let present = marked.contains_batch(&keys).await?;
+    let mut seen = BTreeSet::new();
+    let keep: Vec<_> = keys
+        .into_iter()
+        .zip(present)
+        .map(|(key, present)| !present && seen.insert(key))
+        .collect();
+    Ok(frontier
+        .into_iter()
+        .zip(keep)
+        .filter_map(|(step, keep)| keep.then_some(step))
+        .collect())
 }
 
